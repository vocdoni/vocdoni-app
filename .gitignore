# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.yarn*
.pnp.js

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright
/.ui-snapshot

# production
/dist

# misc
.DS_Store
.env*
!.env.example
.vscode
.idea
chakra-config.json
.turbo
.worktrees

# AI related: project skills in .agents/skills/ (symlinked from .claude/skills/) are committed;
# installed ones, such as vocdoni-integrator-sdk, are not
.codex
/.agents/*
*/**/.agents
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/integration-pinning/
!/.agents/skills/payg-billing/
!/.agents/skills/translations/
!/.agents/skills/ui-change/
/.claude/skills/*
!/.claude/skills/integration-pinning
!/.claude/skills/payg-billing
!/.claude/skills/translations
!/.claude/skills/ui-change
.pi
skills-lock.json

# we use pnpm here
package-lock.json
yarn.lock

# pnpm local store (when store-dir is not redirected to /tmp)
.pnpm-store/

# logs
*-debug.log*
*-error.log*

# old translation files
*_old.json

# Local Netlify folder
.netlify
