VOCDONI_ENVIRONMENT=prod
SAAS_URL=https://saas-api-dev.vocdoni.net
PRIORITY_SUPPORT_PHONE="+34 900 123 456"
STRIPE_PUBLIC_KEY=key
GTM_CONTAINER_ID=GTM-XXXXXXX
PLAUSIBLE_DOMAIN=app.vocdoni.io
# PostHog is disabled unless a project API key is set (production only)
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_CLIENT_ID=client-id
CRISP_WEBSITE_ID=
ANNOUNCEMENT='{"message": {"en": "Welcome!", "es": "¡Bienvenido!"}, "status": "info", "lsKey": "unique-local-storage-key"}'
# Turns the app root (/ and /<lang>) into the voting page of a single process,
# instead of the regular homepage. Unset = regular homepage.
HOME_PROCESS_ID=
# Accent color (#rgb or #rrggbb) for buttons, controls, tabs and highlights. Unset = the stock black accent.
PRIMARY_COLOR=
# Set to "true" to show the organization's logo in the header of process pages
# instead of the Vocdoni one. Falls back to the Vocdoni logo when the
# organization has no logo, and on every page not tied to a process. The footer
# logo always stays Vocdoni.
SHOW_ORG_LOGO=
# Set to "true" to hide the anonymous voting option from the process creation wizard.
DISABLE_ANONYMOUS_VOTING=
# Set to "false" to hide the "Open the questions yourself" switch (questions start paused) from the process wizard.
QUESTION_BY_QUESTION=
# Certificate gateway base origin, port included (e.g. https://cert.vocdoni.io:15140). Unset hides the
# "digital certificate" voter sign-in option. Each sign-in attempt goes to a random subdomain of it
# (<label>.cert.vocdoni.io, same port), so the gateway needs a wildcard DNS record and certificate.
# Local development: https://cert.localtest.me:8443 (*.cert.localtest.me resolves to 127.0.0.1).
CERT_GATEWAY_URL=
PRIVACY_POLICY_URL=https://vocdoni.io/privacy
TERMS_OF_SERVICE_URL=https://vocdoni.io/terms
VIDEO_TUTORIAL='{"en": "https://www.youtube.com/watch?v=OQRF_4-zGSk", "es": "https://www.youtube.com/watch?v=zk6yIq3-SHw"}'
